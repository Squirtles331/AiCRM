<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aicrm</groupId>
        <artifactId>aicrm</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>aicrm-service</artifactId>
    <name>aicrm-service</name>
    <description>业务逻辑层：Service/Impl + 消息消费者 + 业务 DTO</description>

    <dependencies>
        <dependency>
            <groupId>com.aicrm</groupId>
            <artifactId>aicrm-dao</artifactId>
        </dependency>

        <!-- Web（渠道 RestClient / 文件上传 / 请求上下文） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- AOP（操作日志自动记录切面） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- JSR-380 参数校验（LoginRequest 等 DTO） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Redis（RedisUtil 缓存/分布式锁模板，Bean 在启动模块装配） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <!-- RabbitMQ（ChannelEventConsumer 消费渠道事件） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- MinIO（可选文件存储，aicrm.storage.type=minio 时启用） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.12</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
