# AI 能力服务配置示例（复制为 .env 使用）
# 服务端口（Java 侧 aicrm.ai-service.base-url 对应此端口）
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100

# LLM Provider: mock / openai / dashscope
LLM_PROVIDER=mock

# OpenAI 兼容接口（海外）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 阿里云百炼（国内）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# 意图分类/抽取等任务使用的模型（可单独指定）
LLM_MODEL_FALLBACK=
